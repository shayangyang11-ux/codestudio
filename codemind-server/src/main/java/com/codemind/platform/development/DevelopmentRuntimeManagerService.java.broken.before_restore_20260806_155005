    private EndpointProbe probeFrontendPreview() {
        EndpointProbe socketProbe = probeTcpPort("127.0.0.1", DEFAULT_FRONTEND_PORT);
        if (socketProbe.reachable()) {
            return socketProbe;
        }

        EndpointProbe httpProbe = probeEndpoint(frontendUrl());
        if (httpProbe.reachable()) {
            return httpProbe;
        }

        String message = socketProbe.message();
        if (message == null || message.isBlank()) {
            message = httpProbe.message();
        }
        return new EndpointProbe(false, true, null, message);
    }

    private EndpointProbe probeTcpPort(String host, int port) {
        try (Socket socket = new Socket()) {
            socket.connect(new InetSocketAddress(host, port), FRONTEND_SOCKET_TIMEOUT_MILLIS);
            return new EndpointProbe(
                    true,
                    false,
                    200,
                    "TCP " + host + ":" + port + " 可连接"
            );
        } catch (Exception e) {
            return new EndpointProbe(
                    false,
                    true,
                    null,
                    e.getClass().getSimpleName() + ": " + e.getMessage()
            );
        }
    }

