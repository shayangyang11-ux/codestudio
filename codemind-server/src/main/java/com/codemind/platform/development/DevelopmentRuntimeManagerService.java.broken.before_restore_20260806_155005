    private static final class RuntimeSlot {
        private final ArrayDeque<String> logs = new ArrayDeque<>();
        private final AtomicReference<String> runtimeStatus = new AtomicReference<>("STOPPED");
        private final AtomicReference<String> installStatus = new AtomicReference<>("NOT_INSTALLED");
        private Process runtimeProcess;
        private Process installProcess;
        private Integer lastExitCode;
        private Integer lastInstallExitCode;
        private LocalDateTime startedAt;
        private LocalDateTime stoppedAt;
        private LocalDateTime lastActionAt;

        synchronized void appendLog(String line, boolean systemLine) {
            String prefix = LocalDateTime.now().toString().replace('T', ' ').substring(0, 19);
            logs.addLast(prefix + " " + (systemLine ? "" : "") + line);

            while (logs.size() > MAX_LOG_LINES) {
                logs.removeFirst();
            }
        }

        synchronized List<String> tail(int limit) {
            List<String> result = new ArrayList<>();
            int skip = Math.max(0, logs.size() - limit);
            int index = 0;

            for (String line : logs) {
                if (index++ >= skip) {
                    result.add(line);
                }
            }

            return result;
        }

        synchronized int size() {
            return logs.size();
        }

        synchronized void refreshProcessState() {
            if (installProcess != null && !installProcess.isAlive()) {
                try {
                    int code = installProcess.exitValue();
                    lastInstallExitCode = code;
                    installStatus.compareAndSet("INSTALLING", code == 0 ? "INSTALLED" : "INSTALL_FAILED");
                } catch (IllegalThreadStateException ignored) {
                }
            }

            if (runtimeProcess != null && !runtimeProcess.isAlive()) {
                try {
                    int code = runtimeProcess.exitValue();
                    lastExitCode = code;
                    if ("RUNNING".equals(runtimeStatus.get()) && code != 0) {
                        runtimeStatus.set("EXITED");
                    }
                    if (stoppedAt == null) {
                        stoppedAt = LocalDateTime.now();
                    }
                } catch (IllegalThreadStateException ignored) {
                }
            }
        }
    }
