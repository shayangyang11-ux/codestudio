CREATE TABLE IF NOT EXISTS project_theme_profile_application_log (
    id UUID PRIMARY KEY,
    workspace_id UUID NOT NULL,
    project_id UUID NULL,
    project_code VARCHAR(128) NOT NULL,
    source VARCHAR(64) NOT NULL,
    style_text TEXT NULL,
    target_page_type VARCHAR(64) NULL,
    agent_mode VARCHAR(64) NULL,
    confidence NUMERIC(6, 4) NULL,
    summary TEXT NULL,
    before_profile JSONB NOT NULL DEFAULT '{}'::jsonb,
    suggestion JSONB NOT NULL DEFAULT '{}'::jsonb,
    update_payload JSONB NOT NULL DEFAULT '{}'::jsonb,
    result_profile JSONB NOT NULL DEFAULT '{}'::jsonb,
    changed_fields JSONB NOT NULL DEFAULT '[]'::jsonb,
    reasons JSONB NOT NULL DEFAULT '[]'::jsonb,
    warnings JSONB NOT NULL DEFAULT '[]'::jsonb,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_theme_profile_app_log_workspace_project_created
    ON project_theme_profile_application_log (workspace_id, project_code, created_at DESC);

CREATE INDEX IF NOT EXISTS idx_theme_profile_app_log_source_created
    ON project_theme_profile_application_log (source, created_at DESC);
