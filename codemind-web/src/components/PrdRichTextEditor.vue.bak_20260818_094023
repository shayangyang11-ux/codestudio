<template>
  <section class="prd-rich-editor">
    <div class="prd-rich-toolbar" role="toolbar" aria-label="富文本工具栏">
      <button type="button" title="标题" @click="formatBlock('H3')">标题</button>
      <button type="button" title="正文" @click="formatBlock('P')">正文</button>
      <span class="toolbar-divider" />
      <button type="button" title="加粗" @click="exec('bold')"><strong>B</strong></button>
      <button type="button" title="斜体" @click="exec('italic')"><em>I</em></button>
      <button type="button" title="下划线" @click="exec('underline')"><u>U</u></button>
      <span class="toolbar-divider" />
      <button type="button" title="无序列表" @click="exec('insertUnorderedList')">• 列表</button>
      <button type="button" title="有序列表" @click="exec('insertOrderedList')">1. 列表</button>
      <span class="toolbar-divider" />
      <select v-model="fontSize" title="字号" @change="applyFontSize">
        <option value="">字号</option>
        <option value="13px">13</option>
        <option value="14px">14</option>
        <option value="16px">16</option>
        <option value="18px">18</option>
        <option value="22px">22</option>
      </select>
      <input v-model="fontColor" type="color" title="字体颜色" @input="applyForeColor" />
      <input v-model="backgroundColor" type="color" title="背景颜色" @input="applyBackColor" />
      <button type="button" title="清除格式" @click="exec('removeFormat')">清除格式</button>
    </div>

    <div
      ref="editorRef"
      class="prd-rich-surface"
      contenteditable="true"
      :data-placeholder="placeholder"
      @input="syncFromDom"
      @blur="syncFromDom"
      @paste="handlePaste"
    />
  </section>
</template>

<script setup lang="ts">
import { nextTick, ref, watch } from 'vue'

const props = withDefaults(defineProps<{
  modelValue: string
  placeholder?: string
}>(), {
  placeholder: '请输入内容，可设置标题、字体、颜色、列表等格式。',
})

const emit = defineEmits<{
  'update:modelValue': [value: string]
}>()

const editorRef = ref<HTMLElement | null>(null)
const fontSize = ref('')
const fontColor = ref('#1f2937')
const backgroundColor = ref('#fff7cc')
let syncingFromProps = false

watch(
  () => props.modelValue,
  async (value) => {
    const editor = editorRef.value
    if (!editor || syncingFromProps) return
    const nextHtml = normalizeInitialValue(value || '')
    if (editor.innerHTML !== nextHtml) {
      editor.innerHTML = nextHtml
    }
  },
  { immediate: false },
)

nextTick(() => {
  const editor = editorRef.value
  if (editor) {
    editor.innerHTML = normalizeInitialValue(props.modelValue || '')
  }
})

function normalizeInitialValue(value: string): string {
  const text = String(value || '').trim()
  if (!text) return ''
  if (looksLikeHtml(text)) return text
  return text
    .split(/\n{2,}/)
    .map((paragraph) => `<p>${escapeHtml(paragraph).replace(/\n/g, '<br>')}</p>`)
    .join('')
}

function looksLikeHtml(value: string): boolean {
  return /<\/?[a-z][\s\S]*>/i.test(String(value || ''))
}

function escapeHtml(value: string): string {
  return String(value || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
}

function exec(command: string, value?: string) {
  const editor = editorRef.value
  if (!editor) return
  editor.focus()
  document.execCommand(command, false, value)
  syncFromDom()
}

function formatBlock(tag: 'H3' | 'P') {
  exec('formatBlock', tag)
}

function applyForeColor() {
  exec('foreColor', fontColor.value)
}

function applyBackColor() {
  exec('backColor', backgroundColor.value)
}

function applyFontSize() {
  const size = fontSize.value
  if (!size) return
  const editor = editorRef.value
  if (!editor) return
  editor.focus()
  document.execCommand('fontSize', false, '7')
  const fonts = editor.querySelectorAll('font[size="7"]')
  fonts.forEach((node) => {
    const span = document.createElement('span')
    span.style.fontSize = size
    span.innerHTML = node.innerHTML
    node.replaceWith(span)
  })
  syncFromDom()
}

function syncFromDom() {
  const editor = editorRef.value
  if (!editor) return
  syncingFromProps = true
  emit('update:modelValue', editor.innerHTML)
  queueMicrotask(() => {
    syncingFromProps = false
  })
}

function handlePaste(event: ClipboardEvent) {
  const html = event.clipboardData?.getData('text/html')
  const text = event.clipboardData?.getData('text/plain')
  if (!html && !text) return
  event.preventDefault()
  if (html) {
    document.execCommand('insertHTML', false, html)
  } else {
    document.execCommand('insertText', false, text || '')
  }
  syncFromDom()
}
</script>

